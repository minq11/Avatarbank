# AvatarClub 환경변수 예시.
#
#   cp .env.example .env   후 값을 채운다. .env 는 절대 커밋하지 않는다(.gitignore 처리됨).
#   기본값은 backend/app/config.py 에 있고, 여기 비워둔 항목은 그 기본값이 쓰인다.
#
# 아래 표기:
#   [필수]   운영에서 반드시 채워야 함. 비면 기능이 죽거나 기동이 막힌다.
#   [권장]   비어도 뜨지만 해당 기능이 동작하지 않음.
#   [선택]   기본값으로 충분.
#
# 운영 도메인은 avatarclub.example.com 자리에 실제 도메인을 넣을 것.

# ──────────────────────────────────────────────────────────────
# 기본
# ──────────────────────────────────────────────────────────────
# docker-compose.prod.yml 이 production 으로 덮어쓴다. 로컬에서만 의미 있음.
ENV=local

# ──────────────────────────────────────────────────────────────
# 데이터베이스 (Neon / PostgreSQL)  [필수]
# ──────────────────────────────────────────────────────────────
# Neon 대시보드의 connection string. 반드시 sslmode=require 를 붙일 것.
# 드라이버는 psycopg2 이므로 postgresql:// 스킴을 쓴다 (postgresql+asyncpg 아님).
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/avatarclub?sslmode=require

# ──────────────────────────────────────────────────────────────
# Redis  [선택]
# ──────────────────────────────────────────────────────────────
# 아직 코드에서 쓰지 않는다. rate_limit.py 는 프로세스 로컬 메모리 기반이라
# uvicorn 워커를 늘리면 제한이 워커 수만큼 느슨해진다. Redis 전환 시 사용.
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────────────────────────────
# JWT  [필수]
# ──────────────────────────────────────────────────────────────
# ENV=production 인데 CHANGE_ME 이면 백엔드가 기동을 거부한다 (main.py 안전장치).
# 생성: openssl rand -hex 32
# 이 값을 바꾸면 발급된 토큰이 전부 무효가 되어 모든 사용자가 로그아웃된다.
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ──────────────────────────────────────────────────────────────
# S3 스토리지  [필수]
# ──────────────────────────────────────────────────────────────
# 업로드·생성 결과 이미지가 전부 여기로 간다.
# IAM 사용자는 이 버킷에 대한 s3:GetObject / PutObject / DeleteObject 만 주면 된다.
# 버킷은 퍼블릭일 필요가 없다 — 표시용 URL 은 presigned 로 만든다(s3_utils.py).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET=avatarclub-storage-prd

# ──────────────────────────────────────────────────────────────
# fal.ai (이미지 생성)  [필수]
# ──────────────────────────────────────────────────────────────
# 이게 비면 생성이 전부 실패한다. 크레딧이 걸린 경로라 오픈 전 반드시 확인할 것.
FAL_API_KEY=
FAL_MODEL=fal-ai/z-image/turbo
FAL_SUBPATH=image-to-image/lora
# 결과 이미지 NSFW 검사. 입력 이미지 거절(fal 422)에는 영향이 없어 현재 꺼둔 상태.
FAL_ENABLE_SAFETY_CHECKER=false

# ──────────────────────────────────────────────────────────────
# CORS  [상황에 따라]
# ──────────────────────────────────────────────────────────────
# 프론트와 백엔드가 같은 오리진(/api 프록시)이면 비워도 된다 — 현재 구성이 그렇다.
# api 서브도메인으로 분리하는 경우에만 프론트 오리진을 콤마로 나열한다.
CORS_EXTRA_ORIGINS=

# ──────────────────────────────────────────────────────────────
# 관리자  [필수]
# ──────────────────────────────────────────────────────────────
# 콤마 구분. /admin/* 접근 판별에 쓴다 (dependencies.py).
# 프론트(stores/auth.ts)에도 메뉴 노출용으로 하드코딩된 주소가 따로 있으니 같이 볼 것.
ADMIN_EMAIL_WHITELIST=minku0128@naver.com

# ──────────────────────────────────────────────────────────────
# 구글 로그인  [권장]
# ──────────────────────────────────────────────────────────────
# GCP 콘솔 → OAuth 클라이언트 ID(웹). 공개돼도 되는 값이라 /auth/config 로 프론트에 내려간다.
# 비우면 인증 모달에서 구글 버튼이 숨는다.
# 중요: GCP 콘솔의 "승인된 자바스크립트 원본" 에 운영 도메인(https://avatarclub.example.com)을
#      추가하지 않으면 버튼만 뜨고 로그인이 실패한다.
GOOGLE_CLIENT_ID=

# ──────────────────────────────────────────────────────────────
# 크레딧 / 결제 (토스페이먼츠)  [필수]
# ──────────────────────────────────────────────────────────────
# 사업자등록·심사 전에는 테스트 키(test_ck_*, test_sk_*)로 운영 가능하다.
# 시크릿 키는 절대 프론트로 나가면 안 된다 — 승인 API 는 서버에서만 호출한다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_API_BASE_URL=https://api.tosspayments.com

# 결제창이 끝난 뒤 브라우저가 돌아올 주소. 반드시 운영 도메인으로 바꿀 것.
# localhost 로 두면 결제는 승인되는데 사용자가 돌아올 곳이 없어진다.
PAYMENT_SUCCESS_URL=https://avatarclub.example.com/payments/success
PAYMENT_FAIL_URL=https://avatarclub.example.com/payments/fail

# 가입 축하 크레딧 (1 크레딧 = 이미지 1장)
SIGNUP_BONUS_CREDITS=10
# 크리에이터당 동시 활성 리딤 코드 수
MAX_ACTIVE_REDEEM_CODES=500

# ──────────────────────────────────────────────────────────────
# 레이트리밋  [선택]
# ──────────────────────────────────────────────────────────────
# IP당 분당 요청 수. 0 = 비활성.
# Cloudflare 뒤에서 실제 IP 가 잡히려면 nginx 의 real_ip 설정이 살아 있어야 한다
# (frontend/cloudflare-realip.conf).
REDEEM_INFO_RATE_LIMIT_PER_MINUTE=30
REDEEM_GENERATE_RATE_LIMIT_PER_MINUTE=6
INQUIRY_RATE_LIMIT_PER_MINUTE=3

# ──────────────────────────────────────────────────────────────
# 문의 메일 (SMTP)  [권장]
# ──────────────────────────────────────────────────────────────
# 비어 있으면 문의는 DB 에 정상 저장되고 /admin/inquiries 에서 볼 수 있지만
# 접수 알림 메일이 안 나가고, 관리자 답장 시도는 503 이 된다.
# Gmail: 2단계 인증 활성화 → 앱 비밀번호 발급 → SMTP_PASSWORD 에 입력.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=gooddonutsyh@gmail.com
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
INQUIRY_NOTIFY_EMAIL=gooddonutsyh@gmail.com

# ──────────────────────────────────────────────────────────────
# 아바타 preview 로컬 저장  [선택]
# ──────────────────────────────────────────────────────────────
# 설정 시 preview 업로드본을 여기에도 저장하고 /static/preview_image/{id}.png 로 서빙한다.
# 컨테이너에서는 preview_image 볼륨이 마운트되는 경로를 쓸 것.
PREVIEW_LOCAL_DIR=/app/preview_image

# ──────────────────────────────────────────────────────────────
# TLS 인증서 경로  [선택]
# ──────────────────────────────────────────────────────────────
# Cloudflare Origin CA 인증서(origin.pem / origin.key)가 있는 디렉터리.
# 비우면 리포 옆의 ./certs 를 쓴다 (.gitignore 로 커밋이 막혀 있다).
# 개인키를 git 작업 트리 밖에 두고 싶을 때만 절대경로로 지정한다.
CERTS_DIR=

# ──────────────────────────────────────────────────────────────
# 프론트 빌드 인자  [선택]
# ──────────────────────────────────────────────────────────────
# docker compose 가 빌드 시 frontend 이미지에 넘긴다.
# 같은 오리진 구성이라 경로면 충분하다. 바꾸면 --build 로 다시 빌드해야 반영된다.
VITE_API_BASE_URL=/api
